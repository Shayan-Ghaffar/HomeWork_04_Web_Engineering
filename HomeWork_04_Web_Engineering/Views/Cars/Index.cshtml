@model List<Car>
<div class="container">
    <div class="text-center text-capitalize fw-bold container">
        <h1>Available Cars</h1>
    </div>
    <div class="text-center">
        <h3>Choose a car from the following cars:</h3>
    </div>
    @if (Model.Count == 0)
    {
        <div class="alert alert-info text-center py-4" role="alert">
            <h4 class="alert-heading fw-bold">No Cars Available!</h4>
            <p>All cars have been booked. Check back later or view the Booked Cars tab.</p>
        </div>
    }
    else
    {
        <div class="row row-cols-1 row-cols-md-3 g-4">
            @foreach (Car car in @Model)
            {
                <div class="col">
                    <div class="card h-100 shadow-sm text-center">
                        <div class="card-body flex-column">
                            <h5>@car.Name</h5>
                            <h5>PKR @car.PricePerDay Per Day</h5>
                            <span class="badge bg-success">Available</span>
                            <form asp-controller="Cars" asp-action="Book" method="post">
                                <input type="hidden" name="id" value="@car.Id"/>
                                <button class="badge bg-primary w-100">Book Car</button>
                            </form>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>